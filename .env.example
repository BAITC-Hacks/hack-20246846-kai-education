# Backend only. Copy values into .env; never use VITE_ prefixes for secrets.
OPENAI_API_KEY=
# Set an API model available to your account with Responses + Structured Outputs support.
OPENAI_MODEL=
# Browser origin allowed to send credentialed requests and mutations.
FRONTEND_ORIGIN=http://localhost:5173
# Local HTTP demo only. Set true when serving the application over HTTPS.
AUTH_COOKIE_SECURE=false
