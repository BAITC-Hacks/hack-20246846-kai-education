# Independent workflow review: explicit deterministic simulation, NOT an LLM.
# Backend only. Copy this file into a NEW root .env; never overwrite real secrets.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Real OpenAI mode: replace the AI_PROVIDER/OPENAI_API_KEY values above with:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-5.4-mini
# Never put real keys in this file, Git, or VITE_ variables.
# Browser origin allowed to send credentialed requests and mutations.
FRONTEND_ORIGIN=http://localhost:5173
# Local HTTP demo only. Set true when serving the application over HTTPS.
AUTH_COOKIE_SECURE=false
